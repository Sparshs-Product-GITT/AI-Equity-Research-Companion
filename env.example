# Copy this file to `.env` (same folder) and fill in the values. `.env` is git-ignored.
# Values here override anything already set in your shell.
ANTHROPIC_API_KEY=sk-ant-...

# Firm gateway / proxy endpoint. Leave unset to use https://api.anthropic.com directly.
ANTHROPIC_BASE_URL=https://your-gateway.example.com

# Only if the gateway wants a bearer token instead of an x-api-key, or extra headers.
# ANTHROPIC_AUTH_TOKEN=...
# ANTHROPIC_CUSTOM_HEADERS=X-Some-Header: value

# SEC EDGAR fair-access policy requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT=EquityResearchCompanion/0.1 (your.name@example.com)

# Model used by the research subagents.
ER_MODEL=claude-opus-5
# Per-subagent spend cap in USD (safety rail for runaway web research).
ER_MAX_BUDGET_USD=3.0

# Optional. Path to claude.exe if auto-discovery fails (the SDK looks for the Claude desktop
# app's bundled copy, then ~/.local/bin/claude.exe from the native installer).
# CLAUDE_CLI_PATH=C:\path\to\claude.exe
